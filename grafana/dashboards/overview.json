{
  "uid": "llmmonitor-overview",
  "title": "llmMonitor · llama.cpp Live",
  "tags": [
    "llmMonitor",
    "llama.cpp"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"llama\"}, server)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "title": "llama.cpp · Live",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Metriche native del server, campionate ogni 5 secondi. **DOWN**: controlla `--metrics`, URL e log exporter. I pannelli senza dati indicano metriche non esposte dalla versione in uso. I throughput nativi si aggiornano quando llama.cpp pubblica i dati delle richieste; non sono misure per singolo token."
      },
      "id": 1
    },
    {
      "title": "Server raggiungibile",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"llama\",server=~\"$server\"}",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 2
