        "w": 24,
        "h": 10
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "llmmonitor_bench_avg_ts",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tok/s",
