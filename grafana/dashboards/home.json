{
  "uid": "llmmonitor-home",
  "title": "llmMonitor · Home",
  "tags": [
    "llmMonitor",
    "llama.cpp"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "title": "llmMonitor · Il tuo laboratorio locale",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Apri [Hardware](/d/llmmonitor-hardware) per GPU e RAM, [Benchmark](/d/llmmonitor-benchmarks) per i test salvati, oppure [llama.cpp Live](/d/llmmonitor-overview) per il server. **Avviare Grafana non avvia il modello.** Il server deve essere attivo con `--metrics` per mostrare dati di inferenza. Se Exporter è offline, esegui `diagnose` dagli script del progetto."
      },
      "id": 1
    },
    {
      "title": "Exporter raggiungibile",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"llmmonitor\"}",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FERMO",
                  "color": "red"
                },
                "1": {
                  "text": "ATTIVO",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 2
    },
    {
