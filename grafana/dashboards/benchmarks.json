{
  "uid": "llmmonitor-benchmarks",
  "title": "llmMonitor · Benchmark",
  "tags": [
    "llmMonitor",
    "llama.cpp"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llmmonitor_run_status, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "run_id",
        "label": "Run Id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llmmonitor_run_status{model=~\"$model\"}, run_id)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "title": "Laboratorio benchmark",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Run salvate su disco: `bench` misura prefill/decode nativi; `load` misura il servizio HTTP sotto carico. Filtra **run** e **modello** e confronta configurazioni omogenee. I valori delle run sono risultati salvati, non throughput live. Stato: **1** successo, **0** in corso, **-1** fallita, **-2** interrotta. I risultati restano visibili finché conservati in `results/`."
      },
      "id": 1
    },
    {
      "title": "Stato delle run",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "llmmonitor_run_status{run_id=~\"$run_id\",model=~\"$model\"}",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true
            }
          }
        }
      ],
      "id": 2
    },
    {
      "title": "Confronto configurazioni · token/s",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "llmmonitor_bench_avg_ts{run_id=~\"$run_id\",model=~\"$model\"}",
          "legendFormat": "{{model}} · {{test}} · {{threads}} thread · {{run_id}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tok/s",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "id": 3
    },
    {
      "title": "llama-bench · token/s per modello e configurazione",
      "type": "table",
      "datasource": {
        "type": "prometheus",
