# Percorsi relativi alla root del progetto. Non vengono eseguiti come codice shell.
LLAMA_CPP_DIR=
LLAMA_BIN_DIR=
LLAMA_URL=http://host.docker.internal:8080
# URL raggiungibile dagli script sul computer host
LLAMA_LOCAL_URL=http://127.0.0.1:8080
LLAMA_API_KEY=
# Per il router: model ID da usare per /metrics?model=...
LLAMA_METRICS_MODEL=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
# setup genera una password casuale in .env
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d
# setup li valorizza su Linux: il container legge i JSON privati dell'utente host.
HOST_UID=
HOST_GID=
